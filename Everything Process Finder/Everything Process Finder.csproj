<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishAot>true</PublishAot>
        <!-- Shut up the compiler -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
        <PublishTrimmed>true</PublishTrimmed>
        <Authors>Myrkur</Authors>
        <Version>1.1.6</Version>
        <ApplicationIcon>res\Icon.ico</ApplicationIcon>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableRuntimeMarshalling>true</EnableRuntimeMarshalling>
    </PropertyGroup>


    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyName>Everything-Process-Finder-X64Rls</AssemblyName>
        <DebuggerSupport>false</DebuggerSupport>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyName>Everything-Process-Finder-X64Dbg</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="PublishAotCompressed" Version="1.0.5" />
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.0.1" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="res\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Resources\Icon.ico" />
      <EmbeddedResource Include="res\Icon.ico" />
      <None Remove="res\Console.ico" />
      <EmbeddedResource Include="res\Console.ico" />
    </ItemGroup>

</Project>